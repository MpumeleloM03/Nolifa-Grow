rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A verified person: a farm that passed verification, or a phone number
    // that passed the one-time code. Set as a custom claim by the verification
    // service, never by the client. Votes and outbreak confirmations need it,
    // so one person cannot count many times from many accounts.
    function isVerified() {
      return signedIn() && request.auth.token.get('verified', false) == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A farmer's own profile. Readable by other signed-in users so their name
    // can appear on community messages, but only writable by themselves.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // The herd register is private to its owner.
      match /cattle/{animalId} {
        allow read, write: if isOwner(uid);
      }

      // Each animal's health record is just as private as the register.
      match /healthLog/{eventId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Regional chat. Anyone signed in can read and post; you may only post as
    // yourself, and may only delete your own messages.
    match /chatRooms/{region}/messages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.kind in ['message', 'alert'];

      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ───────────────────────── Nolifa Drop marketplace ─────────────────────────
    //
    // Principles: nobody can edit money after an order is created, every state
    // change belongs to exactly one role, and the buyer's PIN never appears in
    // a document a driver can read (only its hash does).
    //
    // Not enforceable in rules, and so done by a trusted backend in the next
    // phase: recomputing order totals from the product prices, and deciding
    // disputes (the mediator claim below). Those are listed in docs/SSDLC.md.

    function commissionFor(uid) {
      let plan = get(/databases/$(database)/documents/marketProfiles/$(uid)).data.state.plan;
      return plan == 'coop' ? 0.03 : (plan == 'grow' ? 0.05 : 0.08);
    }

    function isMediator() {
      return signedIn() && request.auth.token.get('mediator', false) == true;
    }

    // Product stock is optional (null means "not tracked"), but when it is
    // tracked it must be a whole number of units in a sane range.
    function validStock(p) {
      return p.get('stock', null) == null
        || (p.stock is int && p.stock >= 0 && p.stock <= 100000);
    }

    function validAvailable(p) {
      return p.get('available', true) is bool;
    }

    // Private balances, plan, verification checks and ledger.
    match /marketProfiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Produce listed by farmers. Anyone signed in can browse; only the owner
    // can create, change or remove their own listings, and restock or pause them.
    match /marketProducts/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 100000
        && validStock(request.resource.data)
        && validAvailable(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 100000
        && validStock(request.resource.data)
        && validAvailable(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Orders are visible to their buyer, farmer and driver, and (while still
    // unassigned) to any signed-in driver looking for work.
    match /marketOrders/{orderId} {
      function isOpenJob(o) {
        return o.status == 'findingDriver' && o.driverId == null
          && o.get('hubStage', 'released') == 'released';
      }
      function money(o) {
        return [o.lines, o.deliveryFee, o.serviceFee, o.customerId, o.farmerId, o.pinHash, o.method, o.id];
      }
      function onlyChanges(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // A missing document is readable so a phone can check before creating it
      // (the app does this to avoid overwriting a newer copy).
      allow read: if signedIn()
        && (resource == null
          || request.auth.uid in resource.data.participants
          || isOpenJob(resource.data)
          || (isHubStaff() && resource.data.get('route', '') == 'hub'));

      // A buyer creates their own order, unpaid out, undisputed, unassigned.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status in ['newOrder', 'findingDriver']
        && request.resource.data.released == false
        && request.resource.data.dispute == null
        && request.resource.data.driverId == null
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 40
        && request.resource.data.deliveryFee is number
        && request.resource.data.serviceFee is number
        && request.resource.data.pinHash is string
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn() && money(request.resource.data) == money(resource.data) && (

        // The farmer packs a new order, locking in the commission for their plan.
        (resource.data.farmerId == request.auth.uid
          && resource.data.status == 'newOrder'
          && request.resource.data.status == 'findingDriver'
          && request.resource.data.commission == commissionFor(request.auth.uid)
          && onlyChanges(['status', 'commission', 'rev']))

        // The farm says a hub order has been dropped at the hub.
        || (resource.data.farmerId == request.auth.uid
          && resource.data.get('hubStage', '') == 'toHub'
          && resource.data.status == 'findingDriver'
          && request.resource.data.hubStage == 'droppedOff'
          && onlyChanges(['hubStage', 'rev']))

        // Hub staff check an order in, then release it to last-mile drivers.
        || (isHubStaff()
          && resource.data.status == 'findingDriver'
          && ((resource.data.get('hubStage', '') == 'droppedOff' && request.resource.data.hubStage == 'received')
            || (resource.data.get('hubStage', '') == 'received' && request.resource.data.hubStage == 'released'))
          && onlyChanges(['hubStage', 'rev']))

        // A driver claims an open job for themselves.
        || (isOpenJob(resource.data)
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'assigned'
          && request.auth.uid in request.resource.data.participants
          && onlyChanges(['status', 'driver', 'driverId', 'participants', 'rev']))

        // The assigned driver collects (with a photo), then delivers.
        || (resource.data.driverId == request.auth.uid
          && resource.data.dispute == null
          && ((resource.data.status == 'assigned'
                && request.resource.data.status == 'pickedUp'
                && request.resource.data.pickupProof == true
                && onlyChanges(['status', 'pickupProof', 'rev']))
              || (resource.data.status == 'pickedUp'
                && request.resource.data.status == 'delivered'
                && onlyChanges(['status', 'deliveredAt', 'rev']))))

        // A wrong delivery PIN counts as a try. The third wrong try locks the
        // order: the driver's write must open a pinLocked dispute with it, so
        // the money freezes and the PIN cannot be guessed.
        || (resource.data.driverId == request.auth.uid
          && resource.data.status == 'pickedUp'
          && resource.data.dispute == null
          && resource.data.get('pinAttempts', 0) < 2
          && request.resource.data.pinAttempts == resource.data.get('pinAttempts', 0) + 1
          && onlyChanges(['pinAttempts', 'rev']))
        || (resource.data.driverId == request.auth.uid
          && resource.data.status == 'pickedUp'
          && resource.data.dispute == null
          && resource.data.get('pinAttempts', 0) == 2
          && request.resource.data.pinAttempts == 3
          && request.resource.data.dispute.reason == 'pinLocked'
          && request.resource.data.dispute.stage == 'open'
          && request.resource.data.dispute.outcome == null
          && onlyChanges(['pinAttempts', 'dispute', 'rev']))

        // The buyer confirms receipt (releasing payment) and rates.
        || (resource.data.customerId == request.auth.uid
          && resource.data.status == 'delivered'
          && resource.data.dispute == null
          && resource.data.released == false
          && request.resource.data.released == true
          && onlyChanges(['released', 'rating', 'rev']))

        // The buyer opens a dispute. This freezes payment until a mediator rules.
        || (resource.data.customerId == request.auth.uid
          && resource.data.released == false
          && resource.data.dispute == null
          && resource.data.status in ['pickedUp', 'delivered']
          && request.resource.data.dispute.stage == 'open'
          && request.resource.data.dispute.outcome == null
          && onlyChanges(['dispute', 'rev']))

        // Anyone on the order can release payment 2 hours after delivery if
        // the buyer said nothing and no dispute is open.
        || (request.auth.uid in resource.data.participants
          && resource.data.status == 'delivered'
          && resource.data.dispute == null
          && resource.data.released == false
          && request.resource.data.released == true
          && request.time.toMillis() >= resource.data.deliveredAt + 7200000
          && onlyChanges(['released', 'rev']))

        // Only a mediator can rule on a dispute and settle the money.
        || (isMediator()
          && resource.data.dispute != null
          && onlyChanges(['dispute', 'released', 'rev']))
      );

      allow delete: if false;
    }

    // Outbreak cases. Anyone signed in can read. You can file a case as
    // yourself. Neighbours can confirm once each; stage upgrades are made by
    // the confirmations themselves or a vet, never by the reporter.
    match /marketCases/{caseId} {
      function onlyCaseFieldsChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['confirmations', 'confirmedBy', 'stage']);
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.stage == 'aiChecked'
        && request.resource.data.confirmations == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;
      allow update: if signedIn() && (
        // A different neighbour adds themselves once, and only the count moves.
        (isVerified()
          && resource.data.reporterId != request.auth.uid
          && !(request.auth.uid in resource.data.confirmedBy)
          && request.auth.uid in request.resource.data.confirmedBy
          && request.resource.data.confirmations == request.resource.data.confirmedBy.size()
          && request.resource.data.stage in ['aiChecked', 'corroborated']
          && onlyCaseFieldsChange())
        // A vet verifies.
        || (request.auth.token.get('vet', false) == true
          && request.resource.data.stage in ['vetVerified', 'rejected']
          && onlyCaseFieldsChange()));
      allow delete: if false;
    }

    // Community disease sightings feeding the heat map.
    // Append-only: a report may not be edited or removed after the fact, so the
    // outbreak history cannot be quietly rewritten.
    match /outbreaks/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.severity in ['green', 'orange', 'red'];
      allow update, delete: if false;
    }

    // ─────────────────────────── Road hazards (drivers) ───────────────────────────
    //
    // Drivers warn each other about potholes, floods, crashes and roadblocks.
    // Only verified people can write. A new warning starts with its reporter as
    // the one sighting. After that the only edits are one more person saying
    // "still there" (which renews the clock) or "gone", and only for themselves.
    // Nothing is deleted: old warnings simply stop being listened to.
    match /roadHazards/{hazardId} {
      function nowMs() { return request.time.toMillis(); }
      function recent(ms) { return ms is number && ms <= nowMs() + 120000 && ms >= nowMs() - 600000; }
      function kinds() {
        return ['pothole', 'flooding', 'accident', 'roadworks', 'blocked', 'police', 'outage', 'animals'];
      }
      function newer() { return request.resource.data; }
      function older() { return resource.data; }

      // "Still there": adds only the caller to the sightings and removes only the
      // caller from the "gone" list.
      function sawIt() {
        return request.auth.uid in newer().confirms
          && newer().confirms.hasAll(older().confirms)
          && newer().confirms.size() <= older().confirms.size() + 1
          && older().denies.hasAll(newer().denies)
          && newer().denies.hasAll(older().denies.removeAll([request.auth.uid]))
          && recent(newer().lastSeen)
          && newer().lastSeen >= older().lastSeen;
      }

      // "Gone": adds only the caller to the "gone" list and never touches the
      // reporter's own sighting.
      function saidGone() {
        return request.auth.uid in newer().denies
          && newer().denies.hasAll(older().denies)
          && newer().denies.size() <= older().denies.size() + 1
          && older().confirms.hasAll(newer().confirms)
          && newer().confirms.hasAll(older().confirms.removeAll([request.auth.uid]))
          && newer().confirms.hasAll([older().reporter])
          && newer().lastSeen == older().lastSeen;
      }

      allow read: if signedIn();

      allow create: if isVerified()
        && newer().keys().hasOnly(['kind', 'lat', 'lng', 'reportedAt', 'lastSeen',
                                   'reporter', 'reporterName', 'confirms', 'denies', 'note'])
        && newer().kind in kinds()
        && newer().lat is number && newer().lat >= -35 && newer().lat <= -22
        && newer().lng is number && newer().lng >= 16 && newer().lng <= 33
        && newer().reporter == request.auth.uid
        && newer().confirms == [request.auth.uid]
        && newer().denies == []
        && recent(newer().reportedAt)
        && newer().lastSeen == newer().reportedAt
        && newer().reporterName is string && newer().reporterName.size() <= 60
        && newer().note is string && newer().note.size() <= 140;

      allow update: if isVerified()
        && newer().diff(older()).affectedKeys().hasOnly(['confirms', 'denies', 'lastSeen'])
        && (sawIt() || saidGone());

      allow delete: if false;
    }

    // ───────────────────────────── Water radar ─────────────────────────────
    //
    // The water provider is a user whose token carries the `utility` claim. An
    // admin sets that claim from a trusted machine; the apps never can. The
    // provider publishes reservoir readings per community (zone) and is the
    // only one who can move a request past 'requested'.
    //
    // People add their voice once the supply is Low or Critical. A vote is one
    // document whose id is the voter's uid, written in the same transaction as
    // the incident's counter, so one person is one vote per incident and the
    // counter can only move together with a vote.
    //
    // A zone has one live incident at a time. Incidents are chained: epoch 1
    // opens freely, and epoch N opens only once epoch N-1 is resolved, so
    // nobody can invent a higher epoch to hide the real incident or to vote
    // again in a fresh one.
    //
    // Not enforceable in rules, and so left to a trusted backend in the next
    // phase: that a voter really lives in the zone, and that a reading matches
    // the reservoir.

    // Hub staff carry the `hub` permission, set by an admin from a trusted machine.
    function isHubStaff() {
      return signedIn() && request.auth.token.get('hub', false) == true;
    }

    function isUtility() {
      return signedIn() && request.auth.token.get('utility', false) == true;
    }

    // Reservoir readings per community. Anyone signed in can read; only the
    // provider can write, and nothing is ever deleted.
    match /waterZones/{zoneId} {
      function validZone(z) {
        return z.keys().hasOnly(['id', 'name', 'provider', 'reservoir', 'population',
            'voteThreshold', 'readings', 'latest'])
          && z.id == zoneId
          && z.name is string && z.name.size() > 0 && z.name.size() <= 80
          && z.provider is string && z.provider.size() <= 80
          && z.reservoir is string && z.reservoir.size() <= 80
          && z.population is int && z.population >= 0
          && z.voteThreshold is int && z.voteThreshold >= 1 && z.voteThreshold <= 100000
          && z.readings is list && z.readings.size() <= 48
          && (z.latest == null || (z.latest is number && z.latest >= 0 && z.latest <= 100));
      }

      allow read: if signedIn();
      allow create, update: if isUtility() && validZone(request.resource.data);
      allow delete: if false;
    }

    // A community's request for help, named "<zoneId>-<epoch>".
    match /waterIncidents/{incidentId} {
      function votePath() {
        return /databases/$(database)/documents/waterIncidents/$(incidentId)/votes/$(request.auth.uid);
      }
      function incidentKeys() {
        return ['id', 'zoneId', 'epoch', 'stage', 'votes', 'threshold', 'openedAt',
          'requestedAt', 'acknowledgedAt', 'dispatchedAt', 'resolvedAt', 'trucks',
          'etaMinutes', 'note'];
      }
      function onlyIncidentChanges(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // True when "<zoneId>-<epoch - 1>" exists and has been resolved.
      function previousResolved(zoneId, epoch) {
        let prev = /databases/$(database)/documents/waterIncidents/$(zoneId + '-' + string(epoch - 1));
        return exists(prev) && get(prev).data.stage == 'resolved';
      }

      // The first voter opens the incident with their own vote already in it,
      // and only while the zone's latest reading is Low or Critical (below 40).
      // It must follow on from the zone's previous incident, which has to be
      // resolved by then.
      function opensIncident() {
        let n = request.resource.data;
        let z = get(/databases/$(database)/documents/waterZones/$(n.zoneId)).data;
        return n.keys().hasOnly(incidentKeys())
          && n.keys().hasAll(incidentKeys())
          && n.id == incidentId
          && n.epoch is int && n.epoch >= 1
          && incidentId == n.zoneId + '-' + string(n.epoch)
          && (n.epoch == 1 || previousResolved(n.zoneId, n.epoch))
          && z.latest is number && z.latest < 40
          && n.votes == 1
          && n.threshold == z.voteThreshold
          && n.stage == (z.voteThreshold <= 1 ? 'requested' : 'open')
          && (n.stage == 'requested' ? n.requestedAt is number : n.requestedAt == null)
          && n.openedAt is number
          && n.acknowledgedAt == null && n.dispatchedAt == null && n.resolvedAt == null
          && n.trucks == 0 && n.etaMinutes == 0 && n.note == ''
          && existsAfter(votePath());
      }

      // A later voter adds exactly one vote. The stage moves from 'open' to
      // 'requested' when, and only when, the new count reaches the threshold.
      // The zone's level is not rechecked: the incident was opened while the
      // supply was Low, and the client counts every later voice the same way.
      function addsOneVote() {
        let o = resource.data;
        let n = request.resource.data;
        return onlyIncidentChanges(['votes', 'stage', 'requestedAt'])
          && o.stage in ['open', 'requested']
          && n.votes is int && n.votes == o.votes + 1
          && !exists(votePath()) && existsAfter(votePath())
          && ((o.stage == 'open' && n.votes >= o.threshold)
              ? (n.stage == 'requested' && n.requestedAt is number)
              : (n.stage == o.stage && n.requestedAt == o.requestedAt));
      }

      // The provider walks an incident forward: acknowledge, dispatch
      // trucks, resolve. Nothing else about it can be changed.
      function providerStep() {
        let o = resource.data;
        let n = request.resource.data;
        return isUtility() && (
          (o.stage == 'requested' && n.stage == 'acknowledged'
            && n.acknowledgedAt is number
            && onlyIncidentChanges(['stage', 'acknowledgedAt']))
          || (o.stage in ['requested', 'acknowledged'] && n.stage == 'dispatched'
            && n.dispatchedAt is number
            && n.trucks is int && n.trucks >= 1 && n.trucks <= 20
            && n.etaMinutes is int && n.etaMinutes >= 1 && n.etaMinutes <= 1440
            && n.note is string && n.note.size() <= 280
            && onlyIncidentChanges(['stage', 'dispatchedAt', 'trucks', 'etaMinutes', 'note']))
          || (o.stage == 'dispatched' && n.stage == 'resolved'
            && n.resolvedAt is number
            && onlyIncidentChanges(['stage', 'resolvedAt'])));
      }

      allow read: if signedIn();
      allow create: if signedIn() && opensIncident();
      allow update: if signedIn() && (addsOneVote() || providerStep());
      allow delete: if false;

      // One document per voter, named by their uid. Private to the voter; the
      // public number is the incident's counter. It can only be created
      // together with the counter moving by one.
      match /votes/{uid} {
        function countedWithIncident() {
          let inc = /databases/$(database)/documents/waterIncidents/$(incidentId);
          return existsAfter(inc)
            && getAfter(inc).data.stage in ['open', 'requested']
            && (exists(inc)
                ? getAfter(inc).data.votes == get(inc).data.votes + 1
                : getAfter(inc).data.votes == 1);
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isVerified()
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at is number
          && countedWithIncident();
        allow update, delete: if false;
      }
    }

    // A person's own household and tank details. Private to them.
    match /waterPrefs/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['zoneId', 'household', 'tankLitres', 'herd'])
        && (request.resource.data.zoneId == null
            || (request.resource.data.zoneId is string && request.resource.data.zoneId.size() <= 100))
        && request.resource.data.household is int
        && request.resource.data.household >= 0 && request.resource.data.household <= 1000
        && request.resource.data.tankLitres is int
        && request.resource.data.tankLitres >= 0 && request.resource.data.tankLitres <= 10000000
        && request.resource.data.herd is int
        && request.resource.data.herd >= 0 && request.resource.data.herd <= 1000000;
    }
  }
}
